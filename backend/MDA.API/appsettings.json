{
  "ConnectionStrings": {
    "MdaMetadata": "Data Source=Data/mda.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "MDA.API",
    "Audience": "MDA.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Email": {
    "Provider": "Resend",
    "ApiKey": "",
    "From": "MDA <no-reply@yourdomain.com>",
    "FrontendBaseUrl": "https://localhost:5173",
    "VerificationTokenHours": 24
  },
  "AiAnalysis": {
    "Local": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.2:latest",
      "TimeoutSeconds": 90
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
